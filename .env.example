VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Local development and E2E analytics are suppressed unless explicitly enabled.
VITE_POSTHOG_ENABLE_DEV=false
# Server capture uses the public project key; never use a personal API token here.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# CI-only source-map upload credentials. Do not expose these as VITE_ variables.
POSTHOG_PROJECT_ID=492693
POSTHOG_API_KEY=

# Paid Lightning tournaments are disabled unless both frontend and server flags are set.
VITE_TOURNAMENT_PAID_ENABLED=false
TOURNAMENT_PAID_ENABLED=false
TOURNAMENT_LIGHTNING_PROVIDER=lnbits
TOURNAMENT_PUBLIC_BASE_URL=https://your-site.netlify.app
LNBITS_URL=https://lnbits.yourdomain.com
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=
LNBITS_WALLET_ID=
LNBITS_WEBHOOK_SECRET=
ENTRY_USD=2
PRIZE_1_USD=15
PRIZE_2_USD=10
PRIZE_3_USD=5
PAID_TOURNAMENT_MAX_PLAYERS=25
MAX_AUTO_PAYOUT_SATS=50000

# Reusable K.O.R.E. official events use the same Lightning wallet for free-entry prize payouts.
# The admin dashboard also requires funding, rules, and email-delivery confirmations before publish/start.
TOURNAMENT_ADMIN_TOKEN=
TOURNAMENT_RECOVERY_SECRET=
RESEND_API_KEY=
# Public Cloudflare Worker URL used by browser spectators.
VITE_SPECTATOR_RELAY_URL=
# Server-only relay URL and shared HMAC secret. Configure the same secret in Cloudflare.
SPECTATOR_RELAY_URL=
SPECTATOR_TOKEN_SECRET=
