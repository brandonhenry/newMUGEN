VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Paid Lightning tournaments are disabled unless both frontend and server flags are set.
VITE_TOURNAMENT_PAID_ENABLED=false
TOURNAMENT_PAID_ENABLED=false
TOURNAMENT_LIGHTNING_PROVIDER=lnbits
TOURNAMENT_PUBLIC_BASE_URL=https://your-site.netlify.app
LNBITS_URL=https://lnbits.yourdomain.com
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=
LNBITS_WALLET_ID=
LNBITS_WEBHOOK_SECRET=
ENTRY_USD=2
PRIZE_1_USD=15
PRIZE_2_USD=10
PRIZE_3_USD=5
PAID_TOURNAMENT_MAX_PLAYERS=25
MAX_AUTO_PAYOUT_SATS=50000
# Public Cloudflare Worker URL used by browser spectators.
VITE_SPECTATOR_RELAY_URL=
# Server-only relay URL and shared HMAC secret. Configure the same secret in Cloudflare.
SPECTATOR_RELAY_URL=
SPECTATOR_TOKEN_SECRET=
